{
  "name": "mlvt-job-portal",
  "private": true,
  "version": "0.1.0",
  "description": "MLVT Job Portal (demo) for the Claude Code workshop. Synthetic data only.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "db:seed": "tsx scripts/seed.ts",
    "report": "tsx scripts/report.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:api && vite build",
    "build:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build-api/app.mjs",
    "deploy": "vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
